{
  // Cloudflare deployment (the same project also deploys to Vercel). See راهنما.md, section "Cloudflare".
  "name": "mr-judge",
  "main": "cloudflare/worker.js",
  "compatibility_date": "2025-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // only the API goes through the Worker first; files are served straight from dist/
    "run_worker_first": ["/api/*"]
  },
  "durable_objects": {
    "bindings": [{ "name": "STORE", "class_name": "Store" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Store"] }],
  // keep the variables you set in the Cloudflare dashboard when you deploy again
  "keep_vars": true,
  "observability": { "enabled": true }
}
