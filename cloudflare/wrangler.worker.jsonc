{
  // OPTIONAL: deploy as a Cloudflare *Worker* instead of Cloudflare Pages:  npx wrangler deploy -c cloudflare/wrangler.worker.jsonc
  // (the default and simplest way is Cloudflare Pages, which needs no config file here). Paths below are relative to this file.
  "name": "mr-judge",
  "main": "worker.js",
  "compatibility_date": "2025-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "../dist",
    "binding": "ASSETS",
    // only the API goes through the Worker first; files are served straight from dist/
    "run_worker_first": ["/api/*"]
  },
  "durable_objects": {
    "bindings": [{ "name": "STORE", "class_name": "Store" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Store"] }],
  // keep the variables you set in the Cloudflare dashboard when you deploy again
  "keep_vars": true,
  "observability": { "enabled": true }
}
