<!DOCTYPE html>
<html lang="fa" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>آقای قاضی - حل اختلافات هوشمند</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }
        
        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            min-height: 100vh;
            display: flex;
            justify-content: center;
            align-items: center;
            padding: 20px;
        }
        
        .container {
            background: white;
            border-radius: 20px;
            box-shadow: 0 20px 60px rgba(0,0,0,0.3);
            max-width: 800px;
            width: 100%;
            padding: 40px;
        }
        
        .header {
            text-align: center;
            margin-bottom: 40px;
        }
        
        .header h1 {
            font-size: 32px;
            color: #333;
            margin-bottom: 10px;
        }
        
        .judge-emoji {
            font-size: 60px;
            margin-bottom: 15px;
            animation: bounce 2s infinite;
        }
        
        @keyframes bounce {
            0%, 100% { transform: translateY(0); }
            50% { transform: translateY(-10px); }
        }
        
        .header p {
            color: #666;
            font-size: 14px;
        }
        
        .parties-container {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 30px;
            margin-bottom: 30px;
        }
        
        .party {
            border: 2px solid #e0e0e0;
            border-radius: 15px;
            padding: 20px;
            transition: border-color 0.3s;
        }
        
        .party:hover {
            border-color: #667eea;
        }
        
        .party h3 {
            color: #333;
            margin-bottom: 15px;
            font-size: 18px;
        }
        
        .party.first h3 {
            color: #667eea;
        }
        
        .party.second h3 {
            color: #764ba2;
        }
        
        .input-group {
            margin-bottom: 15px;
        }
        
        label {
            display: block;
            font-size: 12px;
            color: #666;
            margin-bottom: 8px;
            font-weight: 600;
        }
        
        textarea {
            width: 100%;
            height: 120px;
            padding: 12px;
            border: 1px solid #ddd;
            border-radius: 8px;
            font-family: inherit;
            font-size: 14px;
            resize: none;
            transition: border-color 0.3s;
        }
        
        textarea:focus {
            outline: none;
            border-color: #667eea;
            box-shadow: 0 0 0 3px rgba(102, 126, 234, 0.1);
        }
        
        .voice-input {
            display: flex;
            gap: 10px;
            align-items: center;
        }
        
        .record-btn {
            padding: 10px 20px;
            background: #667eea;
            color: white;
            border: none;
            border-radius: 8px;
            cursor: pointer;
            font-size: 14px;
            font-weight: 600;
            transition: all 0.3s;
            display: flex;
            align-items: center;
            gap: 8px;
        }
        
        .record-btn:hover {
            background: #5568d3;
            transform: translateY(-2px);
        }
        
        .record-btn.recording {
            background: #e74c3c;
            animation: pulse 1.5s infinite;
        }
        
        @keyframes pulse {
            0%, 100% { opacity: 1; }
            50% { opacity: 0.7; }
        }
        
        .timer {
            font-size: 12px;
            color: #666;
            font-weight: 600;
            min-width: 40px;
        }
        
        .transcription {
            font-size: 12px;
            color: #666;
            margin-top: 8px;
            padding: 8px;
            background: #f5f5f5;
            border-radius: 6px;
            max-height: 60px;
            overflow-y: auto;
        }
        
        .tabs {
            display: flex;
            gap: 8px;
            margin-bottom: 15px;
            border-bottom: 2px solid #e0e0e0;
        }
        
        .tab-btn {
            padding: 8px 12px;
            background: none;
            border: none;
            cursor: pointer;
            color: #666;
            font-size: 13px;
            font-weight: 600;
            border-bottom: 2px solid transparent;
            transition: all 0.3s;
        }
        
        .tab-btn.active {
            color: #667eea;
            border-bottom-color: #667eea;
        }
        
        .tab-content {
            display: none;
        }
        
        .tab-content.active {
            display: block;
        }
        
        .divider {
            text-align: center;
            margin: 30px 0;
            position: relative;
        }
        
        .divider::before {
            content: '';
            position: absolute;
            top: 50%;
            left: 0;
            right: 0;
            height: 1px;
            background: #e0e0e0;
            z-index: 0;
        }
        
        .divider span {
            background: white;
            padding: 0 10px;
            color: #999;
            position: relative;
            z-index: 1;
            font-size: 12px;
        }
        
        .judge-btn {
            width: 100%;
            padding: 14px;
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            color: white;
            border: none;
            border-radius: 10px;
            font-size: 16px;
            font-weight: 700;
            cursor: pointer;
            transition: all 0.3s;
            margin-bottom: 20px;
        }
        
        .judge-btn:hover {
            transform: translateY(-2px);
            box-shadow: 0 10px 30px rgba(102, 126, 234, 0.3);
        }
        
        .judge-btn:disabled {
            opacity: 0.5;
            cursor: not-allowed;
            transform: none;
        }
        
        .judgment {
            background: #f8f9fa;
            border: 2px solid #e0e0e0;
            border-radius: 15px;
            padding: 25px;
            margin-top: 20px;
            display: none;
        }
        
        .judgment.show {
            display: block;
            animation: slideIn 0.5s ease-out;
        }
        
        @keyframes slideIn {
            from {
                opacity: 0;
                transform: translateY(20px);
            }
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }
        
        .judgment h2 {
            color: #333;
            margin-bottom: 15px;
            font-size: 20px;
        }
        
        .judgment-icon {
            font-size: 40px;
            text-align: center;
            margin-bottom: 15px;
        }
        
        .judgment-content {
            color: #333;
            line-height: 1.8;
            font-size: 14px;
        }
        
        .loading {
            display: none;
            text-align: center;
            padding: 20px;
        }
        
        .loading.show {
            display: block;
        }
        
        .spinner {
            border: 3px solid #e0e0e0;
            border-top: 3px solid #667eea;
            border-radius: 50%;
            width: 40px;
            height: 40px;
            animation: spin 0.8s linear infinite;
            margin: 0 auto 10px;
        }
        
        @keyframes spin {
            0% { transform: rotate(0deg); }
            100% { transform: rotate(360deg); }
        }
        
        .error {
            background: #fee;
            color: #c33;
            padding: 12px;
            border-radius: 8px;
            font-size: 13px;
            margin-top: 10px;
            display: none;
        }
        
        .error.show {
            display: block;
        }
        
        .info {
            background: #e3f2fd;
            color: #1565c0;
            padding: 12px;
            border-radius: 8px;
            font-size: 12px;
            margin-top: 10px;
        }
        
        @media (max-width: 600px) {
            .parties-container {
                grid-template-columns: 1fr;
            }
            
            .container {
                padding: 20px;
            }
            
            .header h1 {
                font-size: 24px;
            }
            
            .judge-emoji {
                font-size: 40px;
            }
        }
    </style>
</head>
<body>
    <div class="container">
        <div class="header">
            <div class="judge-emoji">⚖️</div>
            <h1>آقای قاضی</h1>
            <p>حل اختلافات با هوش مصنوعی</p>
        </div>
        
        <div class="parties-container">
            <!-- طرف اول -->
            <div class="party first">
                <h3>طرف اول</h3>
                
                <div class="tabs">
                    <button class="tab-btn active" onclick="switchTab(event, 'party1')">متن</button>
                    <button class="tab-btn" onclick="switchTab(event, 'voice1')">صدا</button>
                </div>
                
                <div class="tab-content active" id="party1">
                    <div class="input-group">
                        <label>اختلاف خود را بنویسید</label>
                        <textarea id="text1" placeholder="داستان خود را بگویید..."></textarea>
                    </div>
                </div>
                
                <div class="tab-content" id="voice1">
                    <div class="input-group">
                        <label>صدای خود را ضبط کنید</label>
                        <div class="voice-input">
                            <button class="record-btn" id="recordBtn1" onclick="toggleRecording(1)">
                                <span>🎤</span>
                                <span>ضبط</span>
                            </button>
                            <div class="timer" id="timer1">۰:۰۰</div>
                        </div>
                        <div class="transcription" id="transcription1" style="display:none;"></div>
                    </div>
                </div>
            </div>
            
            <!-- طرف دوم -->
            <div class="party second">
                <h3>طرف دوم</h3>
                
                <div class="tabs">
                    <button class="tab-btn active" onclick="switchTab(event, 'party2')">متن</button>
                    <button class="tab-btn" onclick="switchTab(event, 'voice2')">صدا</button>
                </div>
                
                <div class="tab-content active" id="party2">
                    <div class="input-group">
                        <label>اختلاف خود را بنویسید</label>
                        <textarea id="text2" placeholder="داستان خود را بگویید..."></textarea>
                    </div>
                </div>
                
                <div class="tab-content" id="voice2">
                    <div class="input-group">
                        <label>صدای خود را ضبط کنید</label>
                        <div class="voice-input">
                            <button class="record-btn" id="recordBtn2" onclick="toggleRecording(2)">
                                <span>🎤</span>
                                <span>ضبط</span>
                            </button>
                            <div class="timer" id="timer2">۰:۰۰</div>
                        </div>
                        <div class="transcription" id="transcription2" style="display:none;"></div>
                    </div>
                </div>
            </div>
        </div>
        
        <div class="divider"><span>🤖</span></div>
        
        <button class="judge-btn" id="judgeBtn" onclick="requestJudgment()">حکم آقای قاضی</button>
        
        <div class="info">
            💡 هر دو طرف می‌توانند متن بنویسند یا صدای خود را ضبط کنند. سپس دکمه "حکم" را بزنید تا آقای قاضی هوشمند بین شما حکم کند.
        </div>
        
        <div class="loading" id="loading">
            <div class="spinner"></div>
            <p>آقای قاضی در حال بررسی اختلاف شما...</p>
        </div>
        
        <div class="error" id="error"></div>
        
        <div class="judgment" id="judgment">
            <div class="judgment-icon">⚔️➡️⚖️</div>
            <h2>تصمیم آقای قاضی</h2>
            <div class="judgment-content" id="judgmentText"></div>
        </div>
    </div>
    
    <script>
        const API_KEY = 'your_api_key_here'; // کاربر باید کلید خود را وارد کند
        
        let mediaRecorders = {};
        let audioChunks = {};
        let isRecording = {};
        let recordingTime = {};
        let timerIntervals = {};
        
        function switchTab(e, tabId) {
            e.target.parentElement.querySelectorAll('.tab-btn').forEach(btn => btn.classList.remove('active'));
            e.target.classList.add('active');
            
            const partyNum = tabId.includes('1') ? '1' : '2';
            document.querySelectorAll(`#party${partyNum}, #voice${partyNum}`).forEach(el => el.classList.remove('active'));
            document.getElementById(tabId).classList.add('active');
        }
        
        async function toggleRecording(partyNum) {
            const btn = document.getElementById(`recordBtn${partyNum}`);
            const key = `party${partyNum}`;
            
            if (!isRecording[key]) {
                try {
                    const stream = await navigator.mediaDevices.getUserMedia({ audio: true });
                    const mediaRecorder = new MediaRecorder(stream);
                    
                    audioChunks[key] = [];
                    recordingTime[key] = 0;
                    
                    mediaRecorder.ondataavailable = (event) => {
                        audioChunks[key].push(event.data);
                    };
                    
                    mediaRecorder.onstop = async () => {
                        const audioBlob = new Blob(audioChunks[key], { type: 'audio/wav' });
                        await transcribeAudio(audioBlob, partyNum);
                        stream.getTracks().forEach(track => track.stop());
                    };
                    
                    mediaRecorders[key] = mediaRecorder;
                    mediaRecorder.start();
                    
                    isRecording[key] = true;
                    btn.classList.add('recording');
                    btn.innerHTML = '<span>⏹️</span><span>توقف</span>';
                    
                    timerIntervals[key] = setInterval(() => {
                        recordingTime[key]++;
                        const mins = Math.floor(recordingTime[key] / 60);
                        const secs = recordingTime[key] % 60;
                        document.getElementById(`timer${partyNum}`).textContent = 
                            `${String(mins).padStart(2, '0')}:${String(secs).padStart(2, '0')}`;
                    }, 1000);
                } catch (err) {
                    showError('خطا در دسترسی به میکروفن');
                }
            } else {
                mediaRecorders[key].stop();
                isRecording[key] = false;
                btn.classList.remove('recording');
                btn.innerHTML = '<span>🎤</span><span>ضبط</span>';
                clearInterval(timerIntervals[key]);
                document.getElementById(`timer${partyNum}`).textContent = '۰:۰۰';
            }
        }
        
        async function transcribeAudio(audioBlob, partyNum) {
            const formData = new FormData();
            formData.append('file', audioBlob, 'audio.wav');
            formData.append('model', 'whisper-1');
            
            try {
                // این نیاز به API کلید دارد - برای تظاهر:
                const text = `[صدا ضبط شد - ${audioBlob.size} بایت]`;
                document.getElementById(`text${partyNum}`).value = text;
                document.getElementById(`transcription${partyNum}`).textContent = text;
                document.getElementById(`transcription${partyNum}`).style.display = 'block';
            } catch (err) {
                showError('خطا در تبدیل صدا به متن');
            }
        }
        
        function showError(message) {
            const errorEl = document.getElementById('error');
            errorEl.textContent = message;
            errorEl.classList.add('show');
            setTimeout(() => errorEl.classList.remove('show'), 5000);
        }
        
        async function requestJudgment() {
            const text1 = document.getElementById('text1').value.trim();
            const text2 = document.getElementById('text2').value.trim();
            
            if (!text1 || !text2) {
                showError('لطفاً هر دو طرف اختلاف را وارد کنید');
                return;
            }
            
            const judgeBtn = document.getElementById('judgeBtn');
            judgeBtn.disabled = true;
            document.getElementById('loading').classList.add('show');
            document.getElementById('error').classList.remove('show');
            document.getElementById('judgment').classList.remove('show');
            
            try {
                const response = await fetch('https://api.anthropic.com/v1/messages', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'x-api-key': API_KEY,
                        'anthropic-version': '2023-06-01'
                    },
                    body: JSON.stringify({
                        model: 'claude-opus-4-6',
                        max_tokens: 1000,
                        messages: [
                            {
                                role: 'user',
                                content: `تو یک قاضی عادل و دانا به نام "آقای قاضی" هستی که در حل اختلافات و منازعات متخصص است.

اختلاف:
طرف اول: ${text1}

طرف دوم: ${text2}

لطفاً با عدالت، عقلانیت و تحلیل دقیق، تصمیم بگیر کدام طرف بیشتر حق دارد و چه راه حلی مناسب است. تصمیم خود را به شکل واضح و منطقی بیان کن.`
                            }
                        ]
                    })
                });
                
                if (!response.ok) {
                    throw new Error('خطا در ارتباط با سرور');
                }
                
                const data = await response.json();
                const judgment = data.content[0].text;
                
                document.getElementById('judgmentText').textContent = judgment;
                document.getElementById('loading').classList.remove('show');
                document.getElementById('judgment').classList.add('show');
            } catch (err) {
                showError('خطا در دریافت حکم: ' + err.message + '. لطفاً API کلید خود را بررسی کنید.');
                document.getElementById('loading').classList.remove('show');
            } finally {
                judgeBtn.disabled = false;
            }
        }
    </script>
</body>
</html>
